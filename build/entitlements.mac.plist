<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Only used if hardenedRuntime is enabled (notarization env present). allow-jit is required by V8.
       allow-unsigned-executable-memory is intentionally absent (not needed by Electron 45; SECURITY.md Info). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Camera / microphone for sites the user allowed via the permission prompt (T13). -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
