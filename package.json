{
  "name": "retronet",
  "version": "0.1.0",
  "description": "RetroNet: a retro-themed desktop browser",
  "private": true,
  "main": "./out/main/index.js",
  "author": "RetroNet",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite build --watch",
    "start": "electron .",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run && electron-vite build && playwright test",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:soak": "playwright test -c playwright.soak.config.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "icons": "node scripts/make-icons.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "dist:mac": "npm run icons && electron-vite build && electron-builder --mac --universal --config electron-builder.config.cjs",
    "dist:win": "npm run icons && electron-vite build && electron-builder --win --config electron-builder.config.cjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "png2icons": "2.0.1",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
